{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edna-e-majka",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edna-e-majka",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "edna-e-majka-assets",
    },
  ],
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  "vars": {
    "APP_URL": "http://localhost:3000",
    "EMAIL_FROM": "noreply@ednaemajka.antonio.mk",
    "EMAIL_FROM_NAME": "Една е Мајка",
  },
}
